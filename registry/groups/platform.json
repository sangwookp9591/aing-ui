            "--aing-dialog-ease": "ease-out, var(--aing-spring), var(--aing-spring), ease-out, ease-out",
            "--aing-spring": "linear(\n      0,\n      0.145,\n      0.401,\n      0.631,\n      0.796,\n      0.899,\n      0.958,\n      0.987,\n      1,\n      1.004,\n      1.004,\n      1.003,\n      1.002,\n      1.001,\n      1\n    )"
          },
          ".dark": {
            "color-scheme": "dark",
            "--aing-backdrop": "rgb(0 0 0 / 0.6)",
            "--background": "#101012",
            "--foreground": "#fafafa",
            "--card": "#18181b",
            "--muted": "#27272a",
            "--muted-foreground": "#ababaf",
            "--border": "#343438",
            "--input": "#71717a",
            "--ring": "#fafafa",
            "--primary": "#fafafa",
            "--primary-foreground": "#18181b",
            "--secondary": "#27272a",
            "--secondary-foreground": "#fafafa",
            "--destructive": "#b91c1c"
          },
          ".aing-button, .aing-select, .aing-dialog": {
            "box-sizing": "border-box",
            "font-family": "var(--font-host, \"Host Grotesk\"), \"Apple SD Gothic Neo\", \"Malgun Gothic\", sans-serif",
            "font-size": "14px"
          },
          ".aing-button:focus-visible, .aing-select:focus-visible, .aing-dialog :focus-visible": {
            "outline": "3px solid color-mix(in srgb, var(--ring) 50%, transparent)",
            "outline-offset": "0",
            "box-shadow": "none"
          },
          ".aing-button[aria-invalid=\"true\"], .aing-select[aria-invalid=\"true\"], .aing-select:user-invalid": {
            "border-color": "var(--destructive)"
          },
          ".aing-button::before": {
            "content": "\"\"",
            "position": "absolute",
            "inset": "min(0px, calc((100% - 44px) / 2))",
            "min-width": "44px",
            "min-height": "44px"
          }
