          ".aing-button[aria-invalid=\"true\"], .aing-select[aria-invalid=\"true\"], .aing-select:user-invalid": {
            "border-color": "var(--destructive)"
          },
          "@supports (appearance: base-select)": {
            " [data-aing-tailwind=\"select\"]::picker(select)": {
              "appearance": "base-select"
            },
            "[data-aing-tailwind=\"select\"]::picker(select)": {
              "margin-block": "4px",
              "padding": "4px",
              "border": "1px solid var(--border)",
              "border-radius": "var(--radius)",
              "background": "var(--background)",
              "color": "var(--foreground)",
              "box-shadow": "0 8px 24px rgb(0 0 0 / 0.08)",
              "opacity": "0",
              "transform": "translateY(-4px)",
              "transition": "opacity 150ms ease-out,\n        transform 150ms var(--aing-spring),\n        display 150ms allow-discrete,\n        overlay 150ms allow-discrete"
            },
            "[data-aing-tailwind=\"select\"]:open::picker(select)": {
              "opacity": "1",
              "transform": "none",
              "transition-duration": "220ms"
            },
            "[data-aing-tailwind=\"select\"]::picker-icon": {
              "content": "\"\"",
              "width": "16px",
              "height": "16px",
              "background": "var(--muted-foreground)",
              "mask": "var(--aing-chevron) center / 16px no-repeat",
              "transition": "rotate 160ms var(--aing-spring)"
            },
            "[data-aing-tailwind=\"select\"]:open::picker-icon": {
              "rotate": "180deg"
            },
            "[data-aing-tailwind=\"select\"][aria-busy=\"true\"]::picker-icon": {
              "opacity": "0"
            },
            "[data-aing-tailwind=\"select\"] option::checkmark": {
              "content": "\"✓\"",
              "order": "1",
              "margin-left": "auto"
            },
            "@starting-style": {
              "[data-aing-tailwind=\"select\"]:open::picker(select)": {
                "opacity": "0",
                "transform": "translateY(-4px)"
              }
            }
          },
          "@media (prefers-reduced-motion: reduce)": {
            " [data-aing-tailwind=\"select\"]::picker(select), [data-aing-tailwind=\"select\"]::picker-icon": {
              "transition": "none !important"
