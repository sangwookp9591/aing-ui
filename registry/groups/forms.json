              "background": "color-mix(in srgb, var(--destructive) 88%, var(--background))"
            },
            ".aing-button-link:not(:disabled):not([aria-disabled=\"true\"]):hover": {
              "background": "transparent",
              "text-decoration": "underline"
            },
            ".aing-button-ghost:not(:disabled):not([aria-disabled=\"true\"]):hover, .aing-button-link:not(:disabled):not([aria-disabled=\"true\"]):hover": {
