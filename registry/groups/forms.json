            "box-shadow": "0 0 0 3px color-mix(in srgb, var(--destructive) 20%, transparent)"
          },
          ".aing-button-secondary": {
            "background": "var(--secondary)",
            "color": "var(--secondary-foreground)"
          },
          ".aing-button-outline": {
            "border-color": "var(--border)",
            "background": "var(--background)",
            "color": "var(--foreground)"
          },
          ".aing-button-ghost, .aing-button-link": {
            "background": "transparent",
            "color": "var(--foreground)",
            "box-shadow": "none"
          },
          ".aing-button-link": {
            "text-underline-offset": "4px"
          },
          ".aing-button-destructive": {
            "background": "var(--destructive)",
            "color": "var(--destructive-foreground)"
          },
          ".aing-button-sm": {
            "height": "32px",
            "padding-inline": "12px",
            "font-size": "12px"
          },
          ".aing-button-lg": {
            "height": "40px",
            "padding-inline": "24px"
          },
          ".aing-button-icon": {
            "width": "36px",
            "padding": "0"
          },
          ".aing-button:disabled, .aing-button[aria-disabled=\"true\"]:not([data-loading])": {
            "opacity": "0.45",
            "cursor": "not-allowed"
          },
          ".aing-button[data-loading]": {
            "opacity": "1",
            "cursor": "progress"
          },
          ".aing-spinner": {
            "flex-shrink": "0",
            "animation": "aing-spin 800ms linear infinite"
          },
          ".aing-button:not(:disabled):not([aria-disabled=\"true\"]):active": {
            "scale": "0.97"
          },
